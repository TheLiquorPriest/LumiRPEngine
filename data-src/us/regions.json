{
  "schema": "lre-data-src/us/regions/v1",
  "table": "regions",
  "approximate": true,
  "country": "US",
  "currency": "USD",
  "money_unit": "integer cents",
  "reflects_period": "2025-2026 (point-in-time, mid-2025 to early-2026 values)",
  "basis": {
    "summary": "Rounded, approximate state-level figures compiled from well-known public statistics as recalled; not queried live. Intended as plausible defaults, not as authoritative statistics.",
    "state_income_tax_effective_pct": "Approximate effective state income tax as a percent of gross wages for a single filer earning about $60,000 (a middle-income band), after the state standard deduction/exemptions; derived from published 2025 state brackets (Tax Foundation / state revenue departments). Rounded to 0.1. Excludes local income taxes (see local_income_tax_pct_typical) and payroll-type state levies such as CA SDI.",
    "sales_tax_combined_avg_pct": "Tax Foundation 2025 combined state plus population-weighted average local sales tax rate; rounded to 0.01. Hawaii and Alaska values are approximations of the GET / local-only rate.",
    "cost_of_living_multiplier": "US = 1.00. Approximate from BEA Regional Price Parities (all items, 2022-2023 vintage) smoothed to 2025; rounded to 0.01.",
    "median_rent_cents_per_month": "Approximate asking-rent medians for 1BR and 2BR units, a blend of Zumper, Apartment List and HUD FY2025 Fair Market Rent state patterns, rounded to $10. 1BR is the anchor; 2BR is derived as 1BR times a regional ratio (Northeast 1.22, Midwest 1.27, South 1.27, West 1.24; DC uses South) rounded to $10. Statewide medians hide large metro-vs-rural spread.",
    "residential_electricity_cents_per_kwh": "EIA Electric Power Monthly, average residential retail price by state, 2024 annual / 2025 year-to-date, rounded to 0.5 cent. Decimal value in cents (not dollars) per kWh. US average is about 17 cents.",
    "minimum_wage_cents_per_hour": "Effective statutory floor in 2025 for non-tipped adult workers: the higher of the state rate and the federal $7.25. Where rates vary by locality or employer size (NY, OR, MN) the statewide/largest-area figure is used."
  },
  "fields": {
    "id": "Lower-case state abbreviation; stable key.",
    "abbr": "USPS two-letter code (DC for the District of Columbia).",
    "name": "Full jurisdiction name.",
    "census_region": "US Census Bureau region: Northeast | Midwest | South | West.",
    "census_division": "US Census Bureau division (nine divisions).",
    "time_zones": "IANA time-zone ids, primary (most populous area) first. Multi-zone states list every zone in use.",
    "observes_dst": "Whether the state as a whole observes US daylight saving time (AZ and HI do not; see notes for Navajo Nation).",
    "state_income_tax_effective_pct": "Percent (4.5 means 4.5%) of gross wages; 0.0 for states with no wage income tax.",
    "local_income_tax_pct_typical": "Percent; typical additional local/county income tax for a worker in that state (0.0 where uncommon or negligible). Not included in the state rate.",
    "sales_tax_combined_avg_pct": "Percent applied to taxable retail goods; many states exempt groceries or medicine, which this table does not model.",
    "cost_of_living_multiplier": "Dimensionless; scale general prices and rents relative to the national average (1.00).",
    "median_rent_1br_cents_per_month": "Integer cents per month, one-bedroom unit.",
    "median_rent_2br_cents_per_month": "Integer cents per month, two-bedroom unit.",
    "residential_electricity_cents_per_kwh": "Cents (decimal) per kilowatt-hour.",
    "minimum_wage_cents_per_hour": "Integer cents per hour.",
    "notes": "Optional free-text caveats (zone splits, DST exceptions, excluded taxes)."
  },
