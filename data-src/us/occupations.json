{
  "schema": "lre-data-src/us/occupations/v1",
  "table": "occupations",
  "approximate": true,
  "country": "US",
  "currency": "USD",
  "money_unit": "integer cents",
  "reflects_period": "2025-2026 (BLS OES May 2024 medians carried forward, plus 2025 tax parameters)",
  "basis": {
    "wages": "BLS Occupational Employment and Wage Statistics (OES/OEWS) May 2024 national median wages as recalled, rounded; gig, intern and student rows are estimates from platform and survey reports. Hourly-paid occupations use annual = hourly x 2080.",
    "withholding_rate_pct": "Computed estimate of federal income tax withholding plus employee FICA on typical_annual_earnings_cents for a single filer with the 2025 standard deduction ($15,750), 2025 brackets (10/12/22/24/32/35/37%) and FICA 6.2% (to the $176,100 wage base) + 1.45% Medicare. State and local taxes are NOT included (see regions.json). No credits, pre-tax deductions or dependents. Rounded to 0.1.",
    "schedule": "Typical hours/weeks per BLS time-use and industry norms; patterns are defined in calendar.json work_shift_patterns."
  },
  "federal_minimum_wage_cents_per_hour": 725,
  "federal_tipped_cash_wage_cents_per_hour": 213,
  "fields": {
    "id": "Stable occupation key.",
    "title": "Occupation name.",
    "category": "service | retail | personal_service | trades | healthcare | office | tech | education | public_safety | transport | gig | student.",
    "median_hourly_cents": "Integer cents per hour (US median; equivalent hourly for salaried roles = annual / 2080). Tipped roles include tips.",
    "median_annual_cents": "Integer cents per year at full-time-year-round equivalence (hourly x 2080 unless the BLS annual figure is given).",
    "typical_annual_earnings_cents": "Integer cents per year actually earned given typical hours and weeks (differs from median_annual for part-time, seasonal, school-year, gig and student rows).",
    "schedule.pattern": "Id into calendar.json work_shift_patterns.",
    "schedule.typical_hours_per_week": "Paid or worked hours per week while employed.",
    "schedule.weeks_per_year": "Paid weeks per year (unpaid breaks, seasons, school year).",
    "schedule.weekend_work": "none | rare | occasional | rotating | always.",
    "schedule.shifts": "Shift types worked: day | evening | night.",
    "pay_frequency": "weekly | biweekly | semimonthly | monthly | weekly_gig | per_job | none.",
    "benefits": "Typical employer benefits for this role: full (health plus retirement and paid leave) | partial (limited, waiting period, or only above an hours threshold) | none.",
    "benefits_note": "One-line qualifier.",
    "withholding_rate_pct": "Percent (7.6 means 7.6%) of gross pay withheld for federal income tax plus FICA; excludes state and local. 0.0 for independent contractors and FICA-exempt students under the income threshold.",
    "tipped": "True when pay normally includes tips.",
    "self_employed": "True for independent contractors (no withholding).",
    "fica_exempt": "True when the student-employee FICA exemption applies.",
    "estimated_tax_set_aside_pct": "Approximate percent of gross a contractor should set aside for federal income plus self-employment tax."
  },
