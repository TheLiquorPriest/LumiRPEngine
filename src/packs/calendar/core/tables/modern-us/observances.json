  "schema": "lre-table/calendar.observances/v1",
  "revision": "cb84b61b74848557cec90057cab93397",
  "label": "Common observances",
  "source": {"dataPack":"modern-us","file":"us/calendar.json","sourceSchema":"lre-data-src/us/calendar/v1","reflectsPeriod":"2025-2026 rules (no dated instances; rules are stable across years)","approximate":true,"basis":"US Code 5 USC 6103 (federal holidays), NIST/US DOT daylight-saving rules (Uniform Time Act as amended 2005), typical K-12 and college academic calendars from state/district and university catalogs as recalled, BLS National Compensation Survey for paid-holiday prevalence, FLSA and FMCSA hours rules."},
  "columns": {
    "name": {"type":"text"},
    "rule_type": {"type":"enum","values":["computed","fixed","irregular","lunar","nth_weekday","relative","relative_to_easter","rule","weekday_in_window","window"]},
    "month": {"type":"int","doc":"1-12.","optional":true},
    "day": {"type":"int","doc":"Day of month; `fixed` rules.","optional":true},
    "weekday": {"type":"enum","values":["monday","tuesday","wednesday","thursday","friday","saturday","sunday"],"optional":true},
    "n": {"type":"int","doc":"`nth_weekday`: 1-4, or -1 for the last.","optional":true},
    "base": {"type":"ref","ref":"calendar.holidays","doc":"`relative` rules: the holiday the offset counts from.","optional":true},
    "offset_days": {"type":"int","unit":"day","doc":"`relative` and `relative_to_easter` rules.","optional":true},
    "algorithm": {"type":"text","doc":"`computed` rules.","optional":true},
    "window": {"type":"text","doc":"`weekday_in_window` and `irregular` rules.","optional":true},
    "start": {"type":"text","doc":"`window` rules: MM-DD.","optional":true},
    "end": {"type":"text","doc":"`window` rules: MM-DD.","optional":true},
    "rule_text": {"type":"text","doc":"`rule` rules: the rule in words.","optional":true},
    "rule_note": {"type":"text","optional":true}
  },
  "rows": {
    "groundhog_day": {"name":"Groundhog Day","rule_type":"fixed","month":2,"day":2},
    "super_bowl_sunday": {"name":"Super Bowl Sunday","rule_type":"weekday_in_window","weekday":"sunday","window":"Feb 2-Feb 15","rule_note":"In practice the Sunday ~3 weeks after the NFL conference championships; first or second Sunday of February"},
    "valentines_day": {"name":"Valentine's Day","rule_type":"fixed","month":2,"day":14},
    "mardi_gras": {"name":"Mardi Gras (Fat Tuesday)","rule_type":"relative_to_easter","offset_days":-47,"rule_note":"Regional (Gulf Coast, esp. New Orleans)"},
    "st_patricks_day": {"name":"St. Patrick's Day","rule_type":"fixed","month":3,"day":17},
    "april_fools": {"name":"April Fools' Day","rule_type":"fixed","month":4,"day":1},
    "tax_day": {"name":"Federal income tax filing deadline","rule_type":"fixed","month":4,"day":15,"rule_note":"Moves to the next business day when Apr 15 is a weekend or DC holiday; extensions to Oct 15"},
    "easter": {"name":"Easter Sunday","rule_type":"computed","algorithm":"Gregorian computus (anonymous Gregorian algorithm / Meeus-Jones-Butcher)","rule_note":"Falls between Mar 22 and Apr 25. Good Friday = Easter - 2 days; Easter Monday = +1 day"},
    "earth_day": {"name":"Earth Day","rule_type":"fixed","month":4,"day":22},
    "cinco_de_mayo": {"name":"Cinco de Mayo","rule_type":"fixed","month":5,"day":5},
    "mothers_day": {"name":"Mother's Day","rule_type":"nth_weekday","month":5,"weekday":"sunday","n":2},
    "fathers_day": {"name":"Father's Day","rule_type":"nth_weekday","month":6,"weekday":"sunday","n":3},
    "prime_day_season": {"name":"Big mid-summer online sale event (varies)","rule_type":"irregular","window":"July","rule_note":"Announced yearly"},
    "back_to_school_season": {"name":"Back-to-school shopping season","rule_type":"window","start":"07-15","end":"09-05"},
    "halloween": {"name":"Halloween","rule_type":"fixed","month":10,"day":31},
    "election_day": {"name":"General Election Day","rule_type":"rule","month":11,"rule_text":"Tuesday after the first Monday in November, in even-numbered years"},
    "diwali": {"name":"Diwali","rule_type":"lunar","rule_note":"Hindu lunisolar calendar; falls mid-October to mid-November"},
    "thanksgiving_eve": {"name":"Thanksgiving Eve (busiest travel and bar night)","rule_type":"relative","base":"thanksgiving","offset_days":-1},
    "black_friday": {"name":"Black Friday","rule_type":"relative","base":"thanksgiving","offset_days":1},
    "small_business_saturday": {"name":"Small Business Saturday","rule_type":"relative","base":"thanksgiving","offset_days":2},
    "cyber_monday": {"name":"Cyber Monday","rule_type":"relative","base":"thanksgiving","offset_days":4},
    "hanukkah": {"name":"Hanukkah (8 days)","rule_type":"lunar","rule_note":"Begins evening of 25 Kislev; between late November and late December"},
    "christmas_eve": {"name":"Christmas Eve","rule_type":"fixed","month":12,"day":24},
    "kwanzaa": {"name":"Kwanzaa (Dec 26-Jan 1)","rule_type":"window","start":"12-26","end":"01-01"},
    "new_years_eve": {"name":"New Year's Eve","rule_type":"fixed","month":12,"day":31},
    "lunar_new_year": {"name":"Lunar New Year","rule_type":"lunar","rule_note":"Second new moon after the winter solstice; between Jan 21 and Feb 20"},
    "ramadan_eid": {"name":"Ramadan and Eid al-Fitr","rule_type":"lunar","rule_note":"Islamic (Hijri) calendar, shifts about 11 days earlier each Gregorian year"},
    "passover": {"name":"Passover (8 days)","rule_type":"lunar","rule_note":"Begins 15 Nisan; March-April"},
    "rosh_hashanah": {"name":"Rosh Hashanah","rule_type":"lunar","rule_note":"1 Tishrei; September-early October"},
    "pride_month": {"name":"Pride Month","rule_type":"window","start":"06-01","end":"06-30"}
  }
}
